// ─── Approvals ─────────────────────────────────────────────────────────────────
function Approvals({data,setData,perms,user,addToast}){
  const[remarks,setRemarks]=useState({});
  const[filter,setFilter]=useState("all");
  const uName=id=>data._users?.find(u=>u.id===id)?.name||id;
  const handle=(id,action)=>{
    if(!perms.canApprove){addToast("You don't have approval authority","error");return;}
    setData(d=>({...d,
      approvals:d.approvals.map(a=>a.id===id?{...a,status:action,approvedBy:user.id,remarks:remarks[id]||""}:a),
      quotations:action==="approved"?d.quotations.map(q=>{const a=d.approvals.find(x=>x.id===id);return q.id===a?.quotationId?{...q,status:"approved"}:q;}):d.quotations,
      logs:[{id:d.logs.length+1,action:`Approval ${id} ${action} by ${user.name}`,user:user.id,time:"just now",type:"approval"},...d.logs]
    }));
    addToast(`Request ${action} successfully`,action==="approved"?"success":"error");
  };
  const initApproval=(rfqId2,quotationId)=>{
    if(!perms.canCreateRFQ&&!perms.canGeneratePO){addToast("No permission","error");return;}
    const existing=data.approvals.find(a=>a.quotationId===quotationId);
    if(existing){addToast("Approval already requested","warn");return;}
    const id="APR-"+String(data.approvals.length+1).padStart(3,"0");
    setData(d=>({...d,approvals:[...d.approvals,{id,rfqId:rfqId2,quotationId,requestedBy:user.id,approvedBy:null,status:"pending",remarks:"",date:today()}],logs:[{id:d.logs.length+1,action:`Approval requested for ${quotationId}`,user:user.id,time:"just now",type:"approval"},...d.logs]}));
    addToast("Approval request sent to manager");
  };
  const filtered=data.approvals.filter(a=>filter==="all"||a.status===filter);
  return(
    <div>
      <div style={{display:"flex",justifyContent:"space-between",marginBottom:20}}>
        <div style={{display:"flex",gap:6}}>{["all","pending","approved","rejected"].map(s=><button key={s} style={{...S.btn("ghost",true),background:filter===s?C.navy:"transparent",color:filter===s?C.white:C.textM,borderColor:filter===s?C.navy:C.border}} onClick={()=>setFilter(s)}>{s.charAt(0).toUpperCase()+s.slice(1)}{s==="pending"&&data.approvals.filter(a=>a.status==="pending").length>0&&<span style={{background:C.red,color:C.white,borderRadius:"50%",padding:"1px 6px",fontSize:10,marginLeft:6}}>{data.approvals.filter(a=>a.status==="pending").length}</span>}</button>)}</div>
        <div style={{fontSize:13,color:C.textL,display:"flex",alignItems:"center",gap:6}}>
          {perms.canApprove?<><span style={{color:C.green}}>✓</span> You have approval authority</>:<><span style={{color:C.red}}>✗</span> View only — no approval authority</>}
        </div>
      </div>

      {/* Quotations awaiting approval request */}
      {perms.canCreateRFQ&&(
        <div style={{...S.card,marginBottom:20,borderLeft:`4px solid ${C.blue}`}}>
          <div style={{fontSize:14,fontWeight:700,marginBottom:14}}>📋 Quotations Ready for Approval Request</div>
          {data.quotations.filter(q=>q.status==="submitted"&&!data.approvals.find(a=>a.quotationId===q.id)).length===0
            ?<div style={{color:C.textL,fontSize:13}}>All submitted quotations have approval requests.</div>
            :data.quotations.filter(q=>q.status==="submitted"&&!data.approvals.find(a=>a.quotationId===q.id)).map(q=>{
              const rfq=data.rfqs.find(r=>r.id===q.rfqId);const v=data.vendors.find(x=>x.id===q.vendorId);
              return(
                <div key={q.id} style={{display:"flex",justifyContent:"space-between",alignItems:"center",padding:"10px 0",borderBottom:`1px solid ${C.border}`}}>
                  <div><div style={{fontWeight:600,fontSize:13.5}}>{q.id} — {rfq?.title}</div><div style={{fontSize:12,color:C.textL}}>{v?.name} · {fmt(q.price)}</div></div>
                  <button style={S.btn("blue",true)} onClick={()=>initApproval(q.rfqId,q.id)}>Request Approval</button>
                </div>
              );
            })
          }
        </div>
      )}

      <div style={{display:"flex",flexDirection:"column",gap:16}}>
        {filtered.map(a=>{
          const rfq=data.rfqs.find(r=>r.id===a.rfqId);
          const q=data.quotations.find(x=>x.id===a.quotationId);
          const vendor=data.vendors.find(v=>v.id===q?.vendorId);
          return(
            <div key={a.id} style={{...S.card,borderLeft:`4px solid ${a.status==="pending"?C.gold:a.status==="approved"?C.green:C.red}`}}>
              <div style={{display:"flex",justifyContent:"space-between",alignItems:"flex-start",marginBottom:16}}>
                <div>
                  <div style={{display:"flex",gap:10,alignItems:"center",marginBottom:5}}><span style={{fontWeight:700,fontSize:12,color:C.textL}}>{a.id}</span><span style={S.badge(a.status)}>{a.status}</span></div>
                  <div style={{fontSize:18,fontWeight:800}}>{rfq?.title}</div>
                  <div style={{fontSize:12.5,color:C.textL,marginTop:3}}>Requested on {a.date}</div>
                </div>
              </div>
              <div style={{display:"grid",gridTemplateColumns:"repeat(4,1fr)",gap:12,marginBottom:16}}>
                {[["Quotation",a.quotationId,C.purple],["Vendor",vendor?.name||"—",C.teal],["Quote Value",q?fmt(q.price):"—",C.gold],["Delivery",q?`${q.delivery} days`:"—",C.blue]].map(([l,v,c])=>(
                  <div key={l} style={{background:"#F8FAFC",borderRadius:10,padding:"12px 14px",borderTop:`3px solid ${c}`}}><div style={{fontSize:10.5,color:C.textL,fontWeight:700,marginBottom:5,textTransform:"uppercase"}}>{l}</div><div style={{fontWeight:700,fontSize:14}}>{v}</div></div>
                ))}
              </div>
              {a.status==="pending"&&perms.canApprove?(
                <div>
                  <div style={{marginBottom:12}}><label style={S.label}>Your Decision Remarks</label><input style={S.input} placeholder="Add remarks before approving/rejecting..." value={remarks[a.id]||""} onChange={e=>setRemarks(r=>({...r,[a.id]:e.target.value}))}/></div>
                  <div style={{display:"flex",gap:10}}>
                    <button style={S.btn("success")} onClick={()=>handle(a.id,"approved")}>✓ Approve Procurement</button>
                    <button style={S.btn("danger")} onClick={()=>handle(a.id,"rejected")}>✗ Reject</button>
                  </div>
                </div>
              ):a.status==="pending"?(
                <div style={{background:C.goldL,borderRadius:9,padding:"10px 14px",fontSize:13,color:C.goldD}}>⏳ Awaiting approval from a Manager. You don't have approval authority.</div>
              ):(
                a.remarks&&<div style={{background:a.status==="approved"?C.greenL:C.redL,borderRadius:9,padding:"12px 14px",fontSize:13,color:a.status==="approved"?C.greenD:C.redD}}><strong>Remarks:</strong> "{a.remarks}"</div>
              )}
            </div>
          );
        })}
        {filtered.length===0&&<div style={{...S.card,textAlign:"center",padding:40,color:C.textL}}>No approvals found.</div>}
      </div>
    </div>
  );
}

// ─── Purchase Orders ────────────────────────────────────────────────────────────
function Orders({data,setData,perms,user,addToast}){
  const[modal,setModal]=useState(false);const[form,setForm]=useState({rfqId:"",quotationId:""});const[invModal,setInvModal]=useState(null);
  const create=()=>{
    const q=data.quotations.find(x=>x.id===form.quotationId);if(!q){addToast("Select a quotation","error");return;}
    const approval=data.approvals.find(a=>a.quotationId===form.quotationId);
    if(!approval||approval.status!=="approved"){addToast("Quotation must be approved first","error");return;}
    const rfq=data.rfqs.find(r=>r.id===form.rfqId);
    const tax=Math.round(q.price*0.18);
    const id="PO-2025-"+String(data.orders.length+1).padStart(3,"0");
    const totalQty=rfq?.items?.reduce((s,i)=>s+Number(i.qty),0)||1;
    const po={id,rfqId:form.rfqId,quotationId:q.id,vendorId:q.vendorId,amount:q.price,tax,total:q.price+tax,status:"issued",createdAt:today(),createdBy:user.id,items:rfq?.items?.map(i=>({name:i.name,qty:i.qty,rate:Math.round(q.price/totalQty),amount:Math.round(q.price*Number(i.qty)/totalQty)}))||[]};
    setData(d=>({...d,orders:[...d.orders,po],logs:[{id:d.logs.length+1,action:`${id} generated for ${rfq?.title}`,user:user.id,time:"just now",type:"po"},...d.logs]}));
    addToast(`${id} generated successfully`);setModal(false);
  };
  const genInvoice=(po)=>{
    if(data.invoices.find(i=>i.poId===po.id)){addToast("Invoice already exists for this PO","warn");return;}
    const id="INV-2025-"+String(data.invoices.length+1).padStart(3,"0");
    const inv={id,poId:po.id,vendorId:po.vendorId,amount:po.amount,tax:po.tax,total:po.total,status:"draft",createdAt:today(),dueDate:new Date(Date.now()+30*86400000).toISOString().slice(0,10),createdBy:user.id};
    setData(d=>({...d,invoices:[...d.invoices,inv]}));setInvModal(inv);addToast("Invoice generated");
  };
  const approvedQuotes=data.quotations.filter(q=>q.status==="approved"&&!data.orders.find(o=>o.quotationId===q.id));
  return(
    <div>
      <div style={{display:"flex",justifyContent:"flex-end",marginBottom:20,gap:10}}>
        <button style={S.btn("ghost")} onClick={()=>downloadCSV(`POs_${today()}.csv`,["PO#","Vendor","Subtotal","GST","Total","Status","Date"],data.orders.map(o=>{const v=data.vendors.find(x=>x.id===o.vendorId);return[o.id,v?.name||"",o.amount,o.tax,o.total,o.status,o.createdAt];}))}>⬇ Export</button>
        {perms.canGeneratePO&&<button style={S.btn("primary")} onClick={()=>setModal(true)}>+ Generate PO</button>}
      </div>
      {approvedQuotes.length>0&&perms.canGeneratePO&&(
        <div style={{...S.card,marginBottom:20,borderLeft:`4px solid ${C.green}`,background:C.greenL}}>
          <div style={{fontSize:13.5,fontWeight:700,color:C.greenD,marginBottom:10}}>✅ {approvedQuotes.length} approved quotation{approvedQuotes.length>1?"s":""} ready for PO generation</div>
          <div style={{display:"flex",gap:10,flexWrap:"wrap"}}>
            {approvedQuotes.map(q=>{const v=data.vendors.find(x=>x.id===q.vendorId);const r=data.rfqs.find(x=>x.id===q.rfqId);return(
              <span key={q.id} style={{background:C.white,borderRadius:8,padding:"6px 12px",fontSize:12.5,fontWeight:600,color:C.greenD,border:`1px solid ${C.green}30`}}>{q.id} — {v?.name} — {fmt(q.price)} <span style={{cursor:"pointer",color:C.teal,marginLeft:4}} onClick={()=>{setForm({rfqId:q.rfqId,quotationId:q.id});setModal(true);}}>Generate →</span></span>
            );})}
          </div>
        </div>
      )}
      <div style={{display:"flex",flexDirection:"column",gap:16}}>
        {data.orders.map(po=>{
          const vendor=data.vendors.find(v=>v.id===po.vendorId);const rfq=data.rfqs.find(r=>r.id===po.rfqId);const ei=data.invoices.find(i=>i.poId===po.id);
          return(
            <div key={po.id} style={S.card}>
              <div style={{display:"flex",justifyContent:"space-between",alignItems:"flex-start",marginBottom:16}}>
                <div><div style={{display:"flex",gap:10,alignItems:"center",marginBottom:5}}><span style={{fontSize:20,fontWeight:900}}>{po.id}</span><span style={S.badge("issued")}>Issued</span></div><div style={{fontSize:13.5,color:C.textM}}>{rfq?.title} · <strong style={{color:C.text}}>{vendor?.name}</strong></div><div style={{fontSize:12,color:C.textL,marginTop:3}}>Created: {po.createdAt}</div></div>
                <div style={{textAlign:"right"}}><div style={{fontSize:30,fontWeight:900,color:C.tealD}}>{fmt(po.total)}</div><div style={{fontSize:12,color:C.textL}}>{fmt(po.amount)} + GST {fmt(po.tax)}</div></div>
