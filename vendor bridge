                  <div style={{marginTop:bp?10:0,marginBottom:16}}>
                    <div style={{fontSize:18,fontWeight:900}}>{vendor?.name}</div>
                    <div style={{fontSize:12,color:C.textL,marginTop:3}}>{q.id} · {q.submittedAt}</div>
                  </div>
                  <div style={{marginBottom:18}}>
                    <div style={{fontSize:11,color:C.textL,fontWeight:700,marginBottom:4}}>QUOTED PRICE</div>
                    <div style={{fontSize:32,fontWeight:900,color:bp?C.tealD:C.text}}>{fmt(q.price)}</div>
                    <div style={{fontSize:12,color:C.textL,marginTop:2}}>+GST {fmt(Math.round(q.price*0.18))} = {fmt(q.price+Math.round(q.price*0.18))}</div>
                  </div>
                  <div style={{display:"grid",gridTemplateColumns:"1fr 1fr",gap:10,marginBottom:16}}>
                    <div style={{background:fd?C.greenL:C.bg,borderRadius:10,padding:"12px",textAlign:"center"}}>
                      <div style={{fontSize:11,color:C.textL,fontWeight:700}}>DELIVERY</div>
                      <div style={{fontSize:22,fontWeight:900,color:fd?C.green:C.text,marginTop:4}}>{q.delivery}d</div>
                      {fd&&<div style={{fontSize:10,color:C.green,fontWeight:800,marginTop:2}}>⚡ Fastest</div>}
