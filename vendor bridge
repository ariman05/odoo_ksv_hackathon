            {[["📋","RFQ & Quotation Management","Send RFQs to multiple vendors and compare bids instantly"],["✅","Structured Approval Workflows","Multi-level approvals with full audit trail"],["📦","PO & Invoice Generation","Auto-generate GST-compliant purchase orders and invoices"],["📊","Reports & Analytics","Export detailed reports in CSV/JSON format"]].map(([icon,title,desc])=>(
