// ─── Reports ───────────────────────────────────────────────────────────────────
function Reports({data,users}){
  const[modal,setModal]=useState(false);
  const[type,setType]=useState("vendor_summary");const[fmt2,setFmt2]=useState("csv");
  const[dFrom,setDFrom]=useState("2025-07-01");const[dTo,setDTo]=useState("2025-07-31");
  const[done,setDone]=useState(null);
  const uName=id=>users.find(u=>u.id===id)?.name||id;
  const totalSpend=data.orders.reduce((s,o)=>s+o.total,0);
  const vendorSpend=data.vendors.map(v=>({...v,spend:data.orders.filter(o=>o.vendorId===v.id).reduce((s,o)=>s+o.total,0)})).sort((a,b)=>b.spend-a.spend);
  const maxS=Math.max(...vendorSpend.map(v=>v.spend),1);
  const monthly=[{m:"Jan",s:45000},{m:"Feb",s:78000},{m:"Mar",s:120000},{m:"Apr",s:92000},{m:"May",s:143000},{m:"Jun",s:87000},{m:"Jul",s:totalSpend}];
  const maxM=Math.max(...monthly.map(x=>x.s));

  const RPTS=[
    {id:"vendor_summary",l:"Vendor Summary",icon:"🏢",d:"All vendor details & status"},
    {id:"rfq_status",l:"RFQ Status Report",icon:"📋",d:"RFQs with status & vendors"},
    {id:"quotation_analysis",l:"Quotation Analysis",icon:"💬",d:"Price & delivery comparison"},
    {id:"po_report",l:"Purchase Order Report",icon:"📦",d:"POs with amounts & vendors"},
    {id:"invoice_report",l:"Invoice Register",icon:"🧾",d:"Invoice status & due dates"},
    {id:"spend_analysis",l:"Spend Analysis",icon:"💰",d:"Spend by vendor & category"},
    {id:"approval_log",l:"Approval Log",icon:"✅",d:"All approval decisions"},
    {id:"user_report",l:"User Report",icon:"👥",d:"System users & roles"},
  ];

  const generate=()=>{
    const r=RPTS.find(x=>x.id===type);
    let h=[],rows=[];
    if(type==="vendor_summary"){h=["ID","Name","Category","GST","Email","Phone","City","Status","Rating"];rows=data.vendors.map(v=>[v.id,v.name,v.category,v.gst,v.email,v.phone,v.city,v.status,v.rating]);}
    else if(type==="rfq_status"){h=["RFQ ID","Title","Status","Created","Deadline","Created By","Items","Vendors","Quotations"];rows=data.rfqs.map(r2=>[r2.id,r2.title,r2.status,r2.createdAt,r2.deadline,uName(r2.createdBy),r2.items.length,r2.vendors.length,data.quotations.filter(q=>q.rfqId===r2.id).length]);}
    else if(type==="quotation_analysis"){h=["ID","RFQ","Vendor","Price","Delivery","Status","Date"];rows=data.quotations.map(q=>{const r2=data.rfqs.find(x=>x.id===q.rfqId);const v=data.vendors.find(x=>x.id===q.vendorId);return[q.id,r2?.title||"",v?.name||"",q.price,q.delivery,q.status,q.submittedAt];});}
    else if(type==="po_report"){h=["PO#","RFQ","Vendor","Subtotal","GST","Total","Status","Date"];rows=data.orders.map(o=>{const v=data.vendors.find(x=>x.id===o.vendorId);return[o.id,o.rfqId,v?.name||"",o.amount,o.tax,o.total,o.status,o.createdAt];});}
    else if(type==="invoice_report"){h=["Invoice#","PO","Vendor","Total","Status","Date","Due"];rows=data.invoices.map(i=>{const v=data.vendors.find(x=>x.id===i.vendorId);return[i.id,i.poId,v?.name||"",i.total,i.status,i.createdAt,i.dueDate];});}
    else if(type==="spend_analysis"){h=["Vendor","Category","POs","Total Spend"];rows=data.vendors.map(v=>[v.name,v.category,data.orders.filter(o=>o.vendorId===v.id).length,data.orders.filter(o=>o.vendorId===v.id).reduce((s,o)=>s+o.total,0)]);}
    else if(type==="approval_log"){h=["ID","RFQ","Quotation","Requested By","Approved By","Status","Remarks","Date"];rows=data.approvals.map(a=>[a.id,a.rfqId,a.quotationId,uName(a.requestedBy),a.approvedBy?uName(a.approvedBy):"Pending",a.status,a.remarks,a.date]);}
    else if(type==="user_report"){h=["ID","Name","Email","Role","Department","Status","Created","Last Login"];rows=users.map(u=>[u.id,u.name,u.email,ROLE_INFO[u.role]?.label||u.role,u.department||"",u.status,u.createdAt,u.lastLogin||"Never"]);}
    downloadCSV(`VendorBridge_${r.l.replace(/\s+/g,"_")}_${today()}.csv`,h,rows);
    setDone(r.l);
  };

  return(
    <div>
      <div style={{display:"flex",justifyContent:"space-between",alignItems:"center",marginBottom:24}}>
        <div style={{fontSize:13,color:C.textL}}>Procurement analytics for July 2025</div>
        <button style={S.btn("purple")} onClick={()=>setModal(true)}>📄 Create Report File</button>
      </div>
      <div style={{display:"grid",gridTemplateColumns:"repeat(4,1fr)",gap:16,marginBottom:24}}>
        {[["Total Spend",fmt(totalSpend),C.teal,"This quarter"],["Active Vendors",data.vendors.filter(v=>v.status==="active").length,C.blue,"of "+data.vendors.length+" total"],["Avg Quote",fmt(data.quotations.reduce((s,q)=>s+q.price,0)/Math.max(data.quotations.length,1)),C.gold,"Per RFQ"],["PO Success","100%",C.green,"Approved & issued"]].map(([l,v,c,sub])=>(
          <div key={l} style={{...S.card,borderTop:`4px solid ${c}`}}><div style={{fontSize:11,color:C.textL,fontWeight:700,textTransform:"uppercase",marginBottom:8}}>{l}</div><div style={{fontSize:24,fontWeight:900}}>{v}</div><div style={{fontSize:12,color:c,fontWeight:600,marginTop:6}}>{sub}</div></div>
        ))}
      </div>
      <div style={{display:"grid",gridTemplateColumns:"1fr 1fr",gap:20,marginBottom:20}}>
        <div style={S.card}>
          <div style={{fontSize:15,fontWeight:800,marginBottom:20}}>Monthly Spend Trend</div>
          <div style={{display:"flex",alignItems:"flex-end",gap:8,height:150}}>
            {monthly.map(m=>(
              <div key={m.m} style={{flex:1,display:"flex",flexDirection:"column",alignItems:"center",gap:6}}>
                <div style={{fontSize:9.5,color:C.textL,fontWeight:600}}>{m.s>=1000?Math.round(m.s/1000)+"k":m.s}</div>
                <div style={{width:"100%",background:m.m==="Jul"?C.teal:`${C.blue}60`,borderRadius:"4px 4px 0 0",minHeight:6,height:Math.max(6,m.s/maxM*130),transition:"height 0.4s"}}/>
                <div style={{fontSize:11,color:C.textM,fontWeight:600}}>{m.m}</div>
              </div>
            ))}
          </div>
        </div>
        <div style={S.card}>
          <div style={{fontSize:15,fontWeight:800,marginBottom:18}}>Vendor Spend Share</div>
          {vendorSpend.map(v=>(
            <div key={v.id} style={{marginBottom:13}}>
              <div style={{display:"flex",justifyContent:"space-between",marginBottom:5}}>
                <div style={{display:"flex",alignItems:"center",gap:8}}><div style={{width:8,height:8,borderRadius:"50%",background:v.status==="active"?C.teal:C.textL}}/><span style={{fontSize:13,fontWeight:500}}>{v.name}</span></div>
                <span style={{fontSize:13,fontWeight:700,color:v.spend>0?C.tealD:C.textL}}>{v.spend>0?fmt(v.spend):"No spend"}</span>
              </div>
              <div style={{height:7,background:C.bg,borderRadius:4,overflow:"hidden"}}><div style={{height:"100%",width:`${(v.spend/maxS)*100}%`,background:C.teal,borderRadius:4}}/></div>
            </div>
          ))}
        </div>
      </div>
      <div style={{display:"grid",gridTemplateColumns:"1fr 1fr",gap:20}}>
        <div style={S.card}>
          <div style={{fontSize:15,fontWeight:800,marginBottom:16}}>Procurement Pipeline</div>
          {[["RFQs Created",data.rfqs.length,C.blue,data.rfqs.filter(r=>r.status==="active").length+" active"],["Quotations",data.quotations.length,C.teal,data.quotations.filter(q=>q.status==="approved").length+" approved"],["Purchase Orders",data.orders.length,C.purple,fmt(totalSpend)+" total value"],["Invoices",data.invoices.length,C.gold,data.invoices.filter(i=>i.status==="paid").length+" paid"]].map(([l,v,c,sub])=>(
            <div key={l} style={{display:"flex",justifyContent:"space-between",alignItems:"center",padding:"12px 0",borderBottom:`1px solid ${C.border}`}}>
              <div style={{display:"flex",alignItems:"center",gap:10}}><div style={{width:10,height:10,borderRadius:"50%",background:c}}/><div><div style={{fontSize:13.5,fontWeight:500}}>{l}</div><div style={{fontSize:11.5,color:C.textL}}>{sub}</div></div></div>
              <div style={{fontSize:24,fontWeight:900,color:c}}>{v}</div>
            </div>
          ))}
        </div>
        <div style={S.card}>
          <div style={{fontSize:15,fontWeight:800,marginBottom:16}}>Vendor Performance</div>
          <table style={S.table}>
            <thead><tr>{["Vendor","Rating","Quotes","POs","Status"].map(h=><th key={h} style={S.th}>{h}</th>)}</tr></thead>
            <tbody>{data.vendors.map(v=>(
              <tr key={v.id}><td style={S.td}><div style={{fontWeight:600}}>{v.name}</div><div style={{fontSize:11,color:C.textL}}>{v.category}</div></td><td style={S.td}><Stars n={v.rating}/></td><td style={S.td}>{data.quotations.filter(q=>q.vendorId===v.id).length}</td><td style={S.td}>{data.orders.filter(o=>o.vendorId===v.id).length}</td><td style={S.td}><span style={S.badge(v.status)}>{v.status}</span></td></tr>
