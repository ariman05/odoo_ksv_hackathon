// ─── Profile ───────────────────────────────────────────────────────────────────
function Profile({user,setUser,users,setUsers,addToast}){
  const[form,setForm]=useState({...user,newPass:"",confirmPass:""});
  const save=()=>{
    if(form.newPass){if(form.newPass!==form.confirmPass){addToast("Passwords don't match","error");return;}if(form.newPass.length<6){addToast("Password too short","error");return;}setUsers(u=>u.map(x=>x.id===user.id?{...x,...form,password:form.newPass}:x));setUser(u=>({...u,...form,password:form.newPass}));addToast("Profile updated");}
    else{setUsers(u=>u.map(x=>x.id===user.id?{...x,...form}:x));setUser(u=>({...u,...form}));addToast("Profile updated");}
  };
  const ri=ROLE_INFO[user.role];
  return(
    <div style={{maxWidth:680}}>
      <div style={{...S.card,marginBottom:20}}>
        <div style={{display:"flex",gap:20,alignItems:"center",marginBottom:24}}>
          <div style={{width:72,height:72,borderRadius:18,background:ri?.bg,display:"flex",alignItems:"center",justifyContent:"center",fontSize:28,fontWeight:900,color:ri?.color}}>{user.avatar}</div>
          <div><div style={{fontSize:22,fontWeight:900}}>{user.name}</div><div style={{...S.badge("active"),background:ri?.bg,color:ri?.color,marginTop:6,padding:"5px 14px",fontSize:13}}>{ri?.icon} {ri?.label}</div></div>
        </div>
        <div style={{display:"grid",gridTemplateColumns:"1fr 1fr",gap:14,marginBottom:14}}>
          {[["name","Full Name"],["email","Email Address"],["phone","Phone Number"],["department","Department"]].map(([k,l])=>(
            <div key={k}><label style={S.label}>{l}</label><input style={S.input} value={form[k]||""} onChange={e=>setForm(f=>({...f,[k]:e.target.value}))}/></div>
          ))}
        </div>
        <div style={{display:"grid",gridTemplateColumns:"1fr 1fr",gap:14,marginBottom:20}}>
          <div><label style={S.label}>New Password</label><input style={S.input} type="password" value={form.newPass} onChange={e=>setForm(f=>({...f,newPass:e.target.value}))} placeholder="Leave blank to keep current"/></div>
          <div><label style={S.label}>Confirm Password</label><input style={S.input} type="password" value={form.confirmPass} onChange={e=>setForm(f=>({...f,confirmPass:e.target.value}))} placeholder="Repeat new password"/></div>
        </div>
        <button style={S.btn("primary")} onClick={save}>Save Changes</button>
      </div>
      <div style={S.card}>
        <div style={{fontSize:15,fontWeight:800,marginBottom:16}}>Your Permissions</div>
        <div style={{display:"grid",gridTemplateColumns:"1fr 1fr",gap:8}}>
          {Object.entries(PERMISSIONS[user.role]||{}).map(([k,v])=>(
            <div key={k} style={{display:"flex",gap:8,alignItems:"center",padding:"8px 12px",borderRadius:8,background:v?C.greenL:C.bg}}>
              <span style={{color:v?C.green:C.textL,fontSize:16}}>{v?"✓":"✗"}</span>
              <span style={{fontSize:13,color:v?C.greenD:C.textL,fontWeight:v?600:400}}>{k.replace(/([A-Z])/g," $1").replace("can","").trim()}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  );
}

// ─── NAV ───────────────────────────────────────────────────────────────────────
const NAV=[
  {section:"Main",items:[{id:"dashboard",l:"Dashboard",e:"🏠"},{id:"profile",l:"My Profile",e:"👤"}]},
  {section:"Procurement",items:[{id:"vendors",l:"Vendors",e:"🏢"},{id:"rfqs",l:"RFQ Management",e:"📋"},{id:"quotations",l:"Quotations",e:"💬"},{id:"compare",l:"Compare Quotes",e:"⚖️"}]},
  {section:"Operations",items:[{id:"approvals",l:"Approvals",e:"✅"},{id:"orders",l:"Purchase Orders",e:"📦"},{id:"invoices",l:"Invoices",e:"🧾"}]},
  {section:"Intelligence",items:[{id:"logs",l:"Activity Logs",e:"📜"},{id:"reports",l:"Reports",e:"📊"}]},
  {section:"Admin",items:[{id:"users",l:"User Management",e:"👥"}],adminOnly:true},
];
const TITLES={dashboard:"Dashboard",vendors:"Vendor Management",rfqs:"RFQ Management",quotations:"Quotations",compare:"Quotation Comparison",approvals:"Approval Workflow",orders:"Purchase Orders",invoices:"Invoice Management",logs:"Activity Logs",reports:"Reports & Analytics",users:"User Management",profile:"My Profile"};

// ─── App Root ──────────────────────────────────────────────────────────────────
export default function App(){
  const[users,setUsers]=useState(INIT_USERS);
  const[user,setUser]=useState(null);
  const[page,setPage]=useState("dashboard");
  const[data,setData]=useState(INIT_DATA);
  const[toasts,setToasts]=useState([]);
  const[notifOpen,setNotifOpen]=useState(false);
  const[reportModal,setReportModal]=useState(false);

  useEffect(()=>{const l=document.createElement("link");l.href=FONT;l.rel="stylesheet";document.head.appendChild(l);},[]);

  const addToast=useCallback((msg,type="success")=>{
    const id=Date.now();
    setToasts(t=>[...t,{id,msg,type}]);
    setTimeout(()=>setToasts(t=>t.filter(x=>x.id!==id)),3500);
  },[]);

  const handleLogin=u=>{setUser({...u,lastLogin:"Just now"});setUsers(prev=>prev.map(x=>x.id===u.id?{...x,lastLogin:"Just now"}:x));};
  const handleRegister=u=>{setUsers(prev=>[...prev,u]);setUser(u);addToast(`Account created! Welcome, ${u.name}`);};

  if(!user) return <AuthScreen users={users} onLogin={handleLogin} onRegister={handleRegister}/>;

  const perms=PERMISSIONS[user.role]||{};
  const pending=data.approvals.filter(a=>a.status==="pending").length;

  // inject users into data for lookups
  const dataWithUsers={...data,_users:users};

  const SCREENS={
    dashboard:<Dashboard data={dataWithUsers} users={users} user={user} perms={perms} setPage={setPage}/>,
    vendors:<Vendors data={dataWithUsers} setData={setData} perms={perms} user={user} addToast={addToast}/>,
    rfqs:<RFQs data={dataWithUsers} setData={setData} perms={perms} user={user} addToast={addToast}/>,
    quotations:<Quotations data={dataWithUsers} setData={setData} perms={perms} user={user} addToast={addToast}/>,
    compare:<Compare data={dataWithUsers}/>,
    approvals:<Approvals data={dataWithUsers} setData={setData} perms={perms} user={user} addToast={addToast}/>,
    orders:<Orders data={dataWithUsers} setData={setData} perms={perms} user={user} addToast={addToast}/>,
    invoices:<Invoices data={dataWithUsers} setData={setData} addToast={addToast}/>,
    logs:<Logs data={dataWithUsers} users={users}/>,
    reports:<Reports data={dataWithUsers} users={users}/>,
    users:<UserMgmt users={users} setUsers={setUsers} currentUser={user} addToast={addToast} setData={setData}/>,
    profile:<Profile user={user} setUser={setUser} users={users} setUsers={setUsers} addToast={addToast}/>,
  };

  return(
    <div style={S.app}>
      {/* SIDEBAR */}
      <div style={S.sidebar}>
        <div style={{padding:"22px 20px 18px",borderBottom:`1px solid ${C.navyM}`}}><Logo size={36} showText={true}/></div>
        <div style={{flex:1,overflowY:"auto",padding:"8px 0"}}>
          {NAV.filter(sec=>!sec.adminOnly||perms.canManageUsers).map(sec=>(
            <div key={sec.section}>
              <div style={{color:"#334155",fontSize:9.5,fontWeight:800,letterSpacing:"1.2px",padding:"14px 22px 5px",textTransform:"uppercase"}}>{sec.section}</div>
              {sec.items.map(item=>{
                const active=page===item.id;
                const notif2=item.id==="approvals"&&pending>0;
                return(
                  <div key={item.id} style={{display:"flex",alignItems:"center",gap:10,padding:"9px 22px",cursor:"pointer",borderLeft:`3px solid ${active?C.teal:"transparent"}`,background:active?`${C.teal}14`:"transparent",color:active?C.teal:"#64748B",fontSize:13.5,fontWeight:active?700:400,transition:"all 0.12s"}} onClick={()=>setPage(item.id)}>
                    <span style={{fontSize:16,width:20,textAlign:"center"}}>{item.e}</span>
                    <span style={{flex:1}}>{item.l}</span>
                    {notif2&&<div style={{width:20,height:20,borderRadius:"50%",background:C.red,color:C.white,fontSize:10,fontWeight:800,display:"flex",alignItems:"center",justifyContent:"center"}}>{pending}</div>}
                  </div>
                );
              })}
            </div>
          ))}
          <div style={{padding:"12px 18px 6px"}}>
            <button style={{...S.btn("ghost"),width:"100%",justifyContent:"center",background:`${C.purple}12`,color:C.purple,outline:`1px solid ${C.purple}25`}} onClick={()=>setPage("reports")}>📄 Create Report File</button>
          </div>
        </div>
        <div style={{padding:"14px 18px",borderTop:`1px solid ${C.navyM}`}}>
          <div style={{display:"flex",alignItems:"center",gap:10,cursor:"pointer"}} onClick={()=>setPage("profile")}>
            <div style={{width:36,height:36,borderRadius:10,background:ROLE_INFO[user.role]?.bg||C.tealL,display:"flex",alignItems:"center",justifyContent:"center",fontSize:14,fontWeight:800,color:ROLE_INFO[user.role]?.color||C.tealD,flexShrink:0}}>{user.avatar}</div>
            <div style={{flex:1,minWidth:0}}>
              <div style={{color:C.white,fontSize:13,fontWeight:700,overflow:"hidden",textOverflow:"ellipsis",whiteSpace:"nowrap"}}>{user.name}</div>
              <div style={{color:"#475569",fontSize:11,marginTop:1}}>{ROLE_INFO[user.role]?.label}</div>
            </div>
            <button style={{...S.btn("ghost",true),color:"#475569",padding:"4px 8px",fontSize:13,flexShrink:0}} onClick={e=>{e.stopPropagation();setUser(null);setPage("dashboard");}} title="Sign Out">⏏</button>
          </div>
        </div>
      </div>

      {/* MAIN */}
      <div style={S.main}>
        <div style={S.topbar}>
          <div>
            <div style={{fontSize:19,fontWeight:900,color:C.text}}>{TITLES[page]||"VendorBridge"}</div>
            <div style={{fontSize:11.5,color:C.textL,marginTop:2}}>VendorBridge Procurement ERP · {new Date().toLocaleDateString("en-IN")}</div>
          </div>
          <div style={{display:"flex",gap:10,alignItems:"center"}}>
            {!perms.canViewReports&&null}
            <button style={S.btn("ghost",true)} onClick={()=>setPage("reports")}>📊 Reports</button>
            <div style={{position:"relative"}}>
              <button style={{...S.btn("ghost",true),fontSize:18,padding:"8px 10px",position:"relative"}} onClick={()=>setNotifOpen(o=>!o)}>
                🔔
                {pending>0&&<span style={{position:"absolute",top:4,right:4,width:16,height:16,borderRadius:"50%",background:C.red,color:C.white,fontSize:9,fontWeight:900,display:"inline-flex",alignItems:"center",justifyContent:"center",lineHeight:1}}>{pending}</span>}
              </button>
              {notifOpen&&(
                <div style={{position:"absolute",right:0,top:46,width:320,background:C.white,borderRadius:14,border:`1px solid ${C.border}`,zIndex:100,boxShadow:"0 8px 32px rgba(0,0,0,0.12)",overflow:"hidden"}}>
                  <div style={{padding:"14px 18px",borderBottom:`1px solid ${C.border}`,fontWeight:800,fontSize:14}}>Notifications</div>
                  {data.approvals.filter(a=>a.status==="pending").map(a=>{const rfq=data.rfqs.find(r=>r.id===a.rfqId);return(
                    <div key={a.id} style={{padding:"13px 18px",borderBottom:`1px solid ${C.border}`,cursor:"pointer",transition:"background 0.1s"}} onClick={()=>{setPage("approvals");setNotifOpen(false);}}>
                      <div style={{fontSize:13.5,fontWeight:600}}>⏳ Approval needed</div>
                      <div style={{fontSize:12,color:C.textL,marginTop:3}}>{rfq?.title} · Click to review</div>
                    </div>
                  );})}
                  {pending===0&&<div style={{padding:"20px",textAlign:"center",color:C.green,fontWeight:600}}>✅ All clear!</div>}
                </div>
              )}
            </div>
            <div style={{width:36,height:36,borderRadius:10,background:ROLE_INFO[user.role]?.bg||C.tealL,display:"flex",alignItems:"center",justifyContent:"center",fontSize:14,fontWeight:900,color:ROLE_INFO[user.role]?.color||C.tealD,cursor:"pointer"}} onClick={()=>setPage("profile")} title="Profile">{user.avatar}</div>
          </div>
        </div>
        <div style={S.content} onClick={()=>notifOpen&&setNotifOpen(false)}>
          {SCREENS[page]||SCREENS.dashboard}
        </div>
      </div>

      <Toast toasts={toasts}/>
    </div>
  );
}
