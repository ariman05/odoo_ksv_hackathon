                </div>
              );
            })}
          </div>
          <div style={S.card}>
            <div style={{fontSize:15,fontWeight:800,marginBottom:16}}>Comparison Matrix</div>
            <table style={S.table}>
              <thead><tr><th style={S.th}>Criterion</th>{quotes.map(q=>{const v=data.vendors.find(x=>x.id===q.vendorId);return<th key={q.id} style={S.th}>{v?.name}</th>;})}</tr></thead>
              <tbody>
                {[["Price (excl. GST)",q=>fmt(q.price),q=>q.price===minPrice],["Price (incl. 18% GST)",q=>fmt(q.price+Math.round(q.price*0.18)),q=>q.price===minPrice],["Delivery Time",q=>`${q.delivery} days`,q=>q.delivery===minDel],["Vendor Rating",q=>{const v=data.vendors.find(x=>x.id===q.vendorId);return`${v?.rating||"—"}★`;},()=>false],["Status",q=><span style={S.badge(q.status)}>{q.status}</span>,()=>false]].map(([label,render,win])=>(
