          <div style={{padding:"22px 28px"}}>
            <div style={{display:"grid",gridTemplateColumns:"1fr 1fr",gap:12,marginBottom:20}}>
              {[["Invoice #",invModal.id],["PO Reference",invModal.poId],["Invoice Date",invModal.createdAt],["Due Date (30d)",invModal.dueDate],["Subtotal",fmt(invModal.amount)],["GST (18%)",fmt(invModal.tax)]].map(([k,v])=>(
