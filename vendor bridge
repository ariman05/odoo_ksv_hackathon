                {[1,2].map(s=><div key={s} style={{flex:1,textAlign:"center",padding:"8px",borderRadius:8,background:step===s?C.white:"transparent",fontWeight:step===s?700:500,fontSize:13,color:step===s?C.text:C.textL,boxShadow:step===s?"0 1px 4px rgba(0,0,0,0.1)":"none",transition:"all 0.2s"}}>{s===1?"Personal Info":"Role & Access"}</div>)}
              </div>
              {error&&<div style={{background:C.redL,border:`1px solid #FCA5A5`,borderRadius:9,padding:"10px 14px",marginBottom:16,fontSize:13,color:C.redD}}>⚠️ {error}</div>}
              {step===1&&(
                <>
                  <div style={{marginBottom:14}}><label style={S.label}>Full Name *</label><input style={S.input} value={form.name} onChange={e=>setForm(f=>({...f,name:e.target.value}))} placeholder="e.g. Priya Sharma"/></div>
                  <div style={{marginBottom:14}}><label style={S.label}>Email Address *</label><input style={S.input} type="email" value={form.email} onChange={e=>setForm(f=>({...f,email:e.target.value}))} placeholder="you@company.com"/></div>
                  <div style={{marginBottom:14}}>
                    <label style={S.label}>Password * <span style={{color:C.textL,fontWeight:400}}>(min. 6 characters)</span></label>
                    <div style={{position:"relative"}}>
                      <input style={S.input} type={showPass?"text":"password"} value={form.password} onChange={e=>setForm(f=>({...f,password:e.target.value}))} placeholder="••••••••"/>
                      <span style={{position:"absolute",right:12,top:"50%",transform:"translateY(-50%)",cursor:"pointer",color:C.textL}} onClick={()=>setShowPass(p=>!p)}>{showPass?"🙈":"👁"}</span>
                    </div>
                    {form.password&&(
                      <div style={{display:"flex",gap:4,marginTop:6}}>
                        {[1,2,3,4].map(i=><div key={i} style={{flex:1,height:4,borderRadius:4,background:form.password.length>=(i*2)?i<=1?C.red:i<=2?C.gold:i<=3?C.teal:C.green:C.border,transition:"background 0.3s"}}/>)}
                        <span style={{fontSize:11,color:C.textL,marginLeft:6}}>{form.password.length<4?"Weak":form.password.length<6?"Fair":form.password.length<8?"Good":"Strong"}</span>
                      </div>
                    )}
                  </div>
                  <div style={{marginBottom:24}}><label style={S.label}>Phone</label><input style={S.input} value={form.phone} onChange={e=>setForm(f=>({...f,phone:e.target.value}))} placeholder="+91 98765 43210"/></div>
                  <button style={{...S.btn("primary"),width:"100%",justifyContent:"center",padding:"13px",fontSize:15,borderRadius:10}} onClick={register}>Continue →</button>
                </>
              )}
              {step===2&&(
                <>
                  <div style={{marginBottom:16}}>
                    <label style={S.label}>Select Your Role *</label>
                    <div style={{display:"flex",flexDirection:"column",gap:10}}>
                      {Object.entries(ROLE_INFO).map(([k,v])=>(
                        <label key={k} style={{display:"flex",alignItems:"center",gap:12,padding:"12px 16px",borderRadius:11,border:`2px solid ${form.role===k?v.color:C.border}`,background:form.role===k?v.bg:C.white,cursor:"pointer",transition:"all 0.15s"}}>
                          <input type="radio" name="role" checked={form.role===k} onChange={()=>setForm(f=>({...f,role:k}))} style={{accentColor:v.color}}/>
                          <span style={{fontSize:20}}>{v.icon}</span>
                          <div>
                            <div style={{fontWeight:700,fontSize:13.5,color:form.role===k?v.color:C.text}}>{v.label}</div>
                            <div style={{fontSize:12,color:C.textL,marginTop:2}}>{v.desc}</div>
                          </div>
                        </label>
                      ))}
                    </div>
                  </div>
                  <div style={{marginBottom:24}}>
                    <label style={S.label}>Department *</label>
                    <select style={S.input} value={form.department} onChange={e=>setForm(f=>({...f,department:e.target.value}))}>
                      <option value="">Select department...</option>
                      {DEPARTMENTS.map(d=><option key={d}>{d}</option>)}
                    </select>
                  </div>
                  <div style={{background:C.bg,borderRadius:10,padding:"14px 16px",marginBottom:24,fontSize:12.5,color:C.textM}}>
                    <div style={{fontWeight:700,marginBottom:8,color:C.text}}>📋 What you can do as {ROLE_INFO[form.role]?.label}:</div>
                    {Object.entries(PERMISSIONS[form.role]||{}).filter(([,v])=>v).map(([k])=>(
                      <div key={k} style={{display:"flex",alignItems:"center",gap:6,marginBottom:4}}>
                        <span style={{color:C.green,fontSize:13}}>✓</span>
                        <span>{k.replace(/([A-Z])/g," $1").replace("can","").trim()}</span>
                      </div>
                    ))}
                  </div>
                  <button style={{...S.btn("primary"),width:"100%",justifyContent:"center",padding:"13px",fontSize:15,borderRadius:10,opacity:loading?0.7:1}} onClick={register} disabled={loading}>
                    {loading?"Creating account...":"Create Account ✓"}
                  </button>
                </>
              )}
              <div style={{textAlign:"center",marginTop:16,fontSize:13,color:C.textM}}>
                Already have an account? <span style={{color:C.teal,fontWeight:700,cursor:"pointer"}} onClick={()=>{setMode("login");setError("");}}>Sign in</span>
              </div>
            </>
          )}

          {mode==="forgot"&&(
            <>
              <button style={{...S.btn("ghost",true),marginBottom:20}} onClick={()=>{setMode("login");setError("");}}>← Back to Login</button>
              <div style={{fontSize:24,fontWeight:900,color:C.text,marginBottom:6}}>Reset Password 🔑</div>
              <div style={{color:C.textM,fontSize:13.5,marginBottom:28}}>Enter your email and we'll show your account details.</div>
              {error&&<div style={{background:C.redL,borderRadius:9,padding:"10px 14px",marginBottom:16,fontSize:13,color:C.redD}}>⚠️ {error}</div>}
              <div style={{marginBottom:20}}><label style={S.label}>Email Address</label><input style={S.input} type="email" value={form.email} onChange={e=>setForm(f=>({...f,email:e.target.value}))} placeholder="your@email.com"/></div>
              <button style={{...S.btn("primary"),width:"100%",justifyContent:"center",padding:"13px",borderRadius:10}} onClick={()=>{
                const u=users.find(x=>x.email===form.email);
                if(!u){setError("No account found with this email.");return;}
                alert(`Account found!\nName: ${u.name}\nRole: ${ROLE_INFO[u.role]?.label}\nPassword hint: first 3 chars = "${u.password.slice(0,3)}..."\n\nIn production, a reset link would be emailed.`);
                setMode("login");
              }}>Find Account</button>
            </>
          )}
        </div>
      </div>
    </div>
  );
}

// ─── User Management (Admin only) ──────────────────────────────────────────────
function UserMgmt({users,setUsers,currentUser,addToast,setData}){
  const[modal,setModal]=useState(false);
  const[editModal,setEditModal]=useState(null);
  const[form,setForm]=useState({name:"",email:"",password:"",role:"officer",phone:"",department:"",status:"active"});
  const[search,setSearch]=useState("");
  const[roleFilter,setRoleFilter]=useState("all");
  const DEPTS=["Procurement","Finance","IT","HR","Operations","Legal","Admin","External"];

  const filtered=users.filter(u=>(roleFilter==="all"||u.role===roleFilter)&&(u.name+u.email+u.department).toLowerCase().includes(search.toLowerCase()));

  const addUser=()=>{
    if(!form.name||!form.email||!form.password){addToast("Fill all required fields","error");return;}
    if(users.find(u=>u.email===form.email)){addToast("Email already exists","error");return;}
    const nu={...form,id:"U"+uid(),avatar:form.name.split(" ").map(n=>n[0]).join("").slice(0,2).toUpperCase(),createdAt:today(),lastLogin:"Never"};
    setUsers(u=>[...u,nu]);
    setData(d=>({...d,logs:[{id:d.logs.length+1,action:`User ${form.name} (${ROLE_INFO[form.role]?.label}) created`,user:currentUser.id,time:"just now",type:"vendor"},...d.logs]}));
    addToast(`User ${form.name} created successfully`);
    setModal(false);setForm({name:"",email:"",password:"",role:"officer",phone:"",department:"",status:"active"});
  };

  const toggleStatus=(uid2)=>{
    if(uid2===currentUser.id){addToast("Cannot modify your own account","error");return;}
    setUsers(u=>u.map(x=>x.id===uid2?{...x,status:x.status==="active"?"suspended":"active"}:x));
    addToast("User status updated");
  };

  const deleteUser=(uid2)=>{
    if(uid2===currentUser.id){addToast("Cannot delete your own account","error");return;}
    if(!confirm("Delete this user? This cannot be undone."))return;
    setUsers(u=>u.filter(x=>x.id!==uid2));
    addToast("User deleted");
  };

  const saveEdit=()=>{
    setUsers(u=>u.map(x=>x.id===editModal.id?{...x,...editModal}:x));
    addToast("User updated successfully");
    setEditModal(null);
  };

  return(
    <div>
      <div style={{display:"flex",justifyContent:"space-between",alignItems:"center",marginBottom:22}}>
        <div style={{display:"flex",gap:10}}>
          <input style={{...S.input,width:260}} placeholder="🔍 Search users..." value={search} onChange={e=>setSearch(e.target.value)}/>
          <select style={{...S.input,width:160}} value={roleFilter} onChange={e=>setRoleFilter(e.target.value)}>
            <option value="all">All Roles</option>
            {Object.entries(ROLE_INFO).map(([k,v])=><option key={k} value={k}>{v.label}</option>)}
          </select>
        </div>
        <button style={S.btn("primary")} onClick={()=>setModal(true)}>+ Add User</button>
      </div>

      {/* Role Summary */}
      <div style={{display:"grid",gridTemplateColumns:"repeat(4,1fr)",gap:14,marginBottom:22}}>
        {Object.entries(ROLE_INFO).map(([k,v])=>{
          const count=users.filter(u=>u.role===k).length;
          return(
            <div key={k} style={{...S.card,borderTop:`4px solid ${v.color}`,cursor:"pointer"}} onClick={()=>setRoleFilter(k)}>
              <div style={{fontSize:22,marginBottom:8}}>{v.icon}</div>
              <div style={{fontSize:22,fontWeight:900,color:C.text}}>{count}</div>
              <div style={{fontSize:12.5,fontWeight:600,color:v.color,marginTop:4}}>{v.label}s</div>
            </div>
          );
        })}
      </div>

      <div style={S.card}>
        <table style={{...S.table}}>
          <thead><tr>{["User","Role","Department","Phone","Status","Last Login","Actions"].map(h=><th key={h} style={S.th}>{h}</th>)}</tr></thead>
          <tbody>{filtered.map(u=>{
            const ri=ROLE_INFO[u.role];
            return(
              <tr key={u.id} style={{background:u.id===currentUser.id?"#FAFFFE":"white"}}>
                <td style={S.td}>
                  <div style={{display:"flex",alignItems:"center",gap:10}}>
                    <div style={{width:36,height:36,borderRadius:10,background:ri?.bg||C.bg,display:"flex",alignItems:"center",justifyContent:"center",fontSize:13,fontWeight:800,color:ri?.color||C.textM}}>{u.avatar}</div>
                    <div><div style={{fontWeight:700,fontSize:13.5}}>{u.name}{u.id===currentUser.id&&<span style={{fontSize:10,background:C.tealL,color:C.tealD,padding:"1px 7px",borderRadius:20,marginLeft:8,fontWeight:700}}>YOU</span>}</div><div style={{fontSize:11.5,color:C.textL}}>{u.email}</div></div>
                  </div>
                </td>
                <td style={S.td}>
                  <div style={{...S.badge("active"),background:ri?.bg,color:ri?.color}}>{ri?.icon} {ri?.label}</div>
                </td>
                <td style={S.td}>{u.department||"—"}</td>
                <td style={{...S.td,fontSize:12.5,color:C.textM}}>{u.phone||"—"}</td>
                <td style={S.td}><span style={S.badge(u.status==="active"?"approved":"rejected")}>{u.status}</span></td>
                <td style={{...S.td,fontSize:12,color:C.textL}}>{u.lastLogin||"Never"}</td>
                <td style={S.td}>
                  <div style={{display:"flex",gap:6}}>
                    <button style={S.btn("ghost",true)} onClick={()=>setEditModal({...u})}>✏ Edit</button>
                    {u.id!==currentUser.id&&(
                      <>
                        <button style={{...S.btn("ghost",true),color:u.status==="active"?C.gold:C.green}} onClick={()=>toggleStatus(u.id)}>{u.status==="active"?"⏸ Suspend":"▶ Activate"}</button>
                        <button style={{...S.btn("ghost",true),color:C.red}} onClick={()=>deleteUser(u.id)}>🗑</button>
                      </>
                    )}
                  </div>
                </td>
              </tr>
            );
          })}</tbody>
        </table>
      </div>

      {/* Add User Modal */}
      {modal&&(
        <div style={S.modal}>
          <div style={S.mbox(620)}>
            <div style={S.mhead}><div style={{fontSize:17,fontWeight:800}}>Add New User</div><button style={{...S.btn("ghost"),fontSize:22,padding:"2px 8px"}} onClick={()=>setModal(false)}>×</button></div>
            <div style={{padding:"22px 28px"}}>
              <div style={{display:"grid",gridTemplateColumns:"1fr 1fr",gap:14,marginBottom:14}}>
                {[["name","Full Name *","text"],["email","Email *","email"],["password","Password *","password"],["phone","Phone","text"],].map(([k,l,t])=>(
                  <div key={k}><label style={S.label}>{l}</label><input style={S.input} type={t} value={form[k]} onChange={e=>setForm(f=>({...f,[k]:e.target.value}))} placeholder={l.replace("*","")}/></div>
                ))}
              </div>
              <div style={{display:"grid",gridTemplateColumns:"1fr 1fr",gap:14,marginBottom:16}}>
                <div><label style={S.label}>Role *</label><select style={S.input} value={form.role} onChange={e=>setForm(f=>({...f,role:e.target.value}))}>{Object.entries(ROLE_INFO).map(([k,v])=><option key={k} value={k}>{v.icon} {v.label}</option>)}</select></div>
                <div><label style={S.label}>Department *</label><select style={S.input} value={form.department} onChange={e=>setForm(f=>({...f,department:e.target.value}))}><option value="">Select...</option>{["Procurement","Finance","IT","HR","Operations","Legal","Admin","External"].map(d=><option key={d}>{d}</option>)}</select></div>
              </div>
              <div style={{background:ROLE_INFO[form.role]?.bg||C.bg,borderRadius:11,padding:"14px 16px",fontSize:12.5,color:C.textM}}>
                <div style={{fontWeight:700,color:ROLE_INFO[form.role]?.color,marginBottom:8}}>{ROLE_INFO[form.role]?.icon} {ROLE_INFO[form.role]?.label} — Permissions</div>
                <div style={{display:"grid",gridTemplateColumns:"1fr 1fr",gap:4}}>
                  {Object.entries(PERMISSIONS[form.role]||{}).map(([k,v])=>(
                    <div key={k} style={{display:"flex",gap:6,alignItems:"center"}}><span style={{color:v?C.green:C.textXL,fontSize:14}}>{v?"✓":"✗"}</span><span style={{color:v?C.text:C.textL}}>{k.replace(/([A-Z])/g," $1").replace("can","").trim()}</span></div>
                  ))}
                </div>
              </div>
            </div>
            <div style={S.mfoot}><button style={S.btn("ghost")} onClick={()=>setModal(false)}>Cancel</button><button style={S.btn("primary")} onClick={addUser}>Create User</button></div>
          </div>
        </div>
      )}

      {/* Edit User Modal */}
      {editModal&&(
        <div style={S.modal}>
          <div style={S.mbox(580)}>
            <div style={S.mhead}><div style={{fontSize:17,fontWeight:800}}>Edit User — {editModal.name}</div><button style={{...S.btn("ghost"),fontSize:22,padding:"2px 8px"}} onClick={()=>setEditModal(null)}>×</button></div>
            <div style={{padding:"22px 28px"}}>
              <div style={{display:"grid",gridTemplateColumns:"1fr 1fr",gap:14,marginBottom:14}}>
                {[["name","Full Name"],["email","Email"],["phone","Phone"]].map(([k,l])=>(
                  <div key={k}><label style={S.label}>{l}</label><input style={S.input} value={editModal[k]||""} onChange={e=>setEditModal(m=>({...m,[k]:e.target.value}))}/></div>
                ))}
                <div><label style={S.label}>Password (leave blank to keep)</label><input style={S.input} type="password" placeholder="New password..." value={editModal.newPass||""} onChange={e=>setEditModal(m=>({...m,newPass:e.target.value}))}/></div>
              </div>
              <div style={{display:"grid",gridTemplateColumns:"1fr 1fr",gap:14}}>
                <div><label style={S.label}>Role</label><select style={S.input} value={editModal.role} onChange={e=>setEditModal(m=>({...m,role:e.target.value}))} disabled={editModal.id===currentUser.id}>{Object.entries(ROLE_INFO).map(([k,v])=><option key={k} value={k}>{v.icon} {v.label}</option>)}</select></div>
                <div><label style={S.label}>Department</label><select style={S.input} value={editModal.department||""} onChange={e=>setEditModal(m=>({...m,department:e.target.value}))}><option value="">Select...</option>{DEPTS.map(d=><option key={d}>{d}</option>)}</select></div>
                <div><label style={S.label}>Status</label><select style={S.input} value={editModal.status} onChange={e=>setEditModal(m=>({...m,status:e.target.value}))} disabled={editModal.id===currentUser.id}><option value="active">Active</option><option value="suspended">Suspended</option></select></div>
              </div>
            </div>
            <div style={S.mfoot}><button style={S.btn("ghost")} onClick={()=>setEditModal(null)}>Cancel</button><button style={S.btn("primary")} onClick={saveEdit}>Save Changes</button></div>
          </div>
        </div>
      )}
    </div>
  );
}

// ─── Dashboard ─────────────────────────────────────────────────────────────────
function Dashboard({data,users,user,perms,setPage}){
  const pending=data.approvals.filter(a=>a.status==="pending").length;
  const totalSpend=data.orders.reduce((s,o)=>s+o.total,0);
  const myName=u=>users.find(x=>x.id===u)?.name||u;

  const stats=[
    {label:"Active Vendors",val:data.vendors.filter(v=>v.status==="active").length,sub:"of "+data.vendors.length+" total",color:C.teal,icon:"🏢",page:"vendors"},
    {label:"Active RFQs",val:data.rfqs.filter(r=>r.status==="active").length,sub:"Awaiting quotations",color:C.blue,icon:"📋",page:"rfqs"},
    {label:"Pending Approvals",val:pending,sub:pending?"Needs attention":"All clear ✓",color:pending?C.gold:C.green,icon:"⏳",page:"approvals"},
    {label:"Total PO Value",val:fmt(totalSpend),sub:"This quarter",color:C.purple,icon:"💰",page:"orders"},
    {label:"Quotations",val:data.quotations.length,sub:data.quotations.filter(q=>q.status==="approved").length+" approved",color:C.orange,icon:"💬",page:"quotations"},
    {label:"Invoices Raised",val:data.invoices.length,sub:fmt(data.invoices.reduce((s,i)=>s+i.total,0))+" total",color:C.green,icon:"🧾",page:"invoices"},
  ];

  return(
    <div>
      <div style={{marginBottom:22,padding:"18px 22px",background:`linear-gradient(135deg, ${C.navy}, ${C.navyM})`,borderRadius:16,display:"flex",justifyContent:"space-between",alignItems:"center"}}>
        <div>
          <div style={{fontSize:20,fontWeight:800,color:C.white}}>Good morning, {user.name.split(" ")[0]} {ROLE_INFO[user.role]?.icon}</div>
          <div style={{color:"#64748B",fontSize:13.5,marginTop:4}}>Here's your procurement overview for today, {new Date().toLocaleDateString("en-IN",{weekday:"long",month:"long",day:"numeric"})}</div>
        </div>
        <div style={{textAlign:"right"}}>
          <div style={{fontSize:11,color:C.textL}}>Your Role</div>
          <div style={{...S.badge("active"),background:`${ROLE_INFO[user.role]?.color}25`,color:ROLE_INFO[user.role]?.color,fontSize:13,marginTop:4,padding:"5px 14px"}}>{ROLE_INFO[user.role]?.icon} {ROLE_INFO[user.role]?.label}</div>
        </div>
      </div>

      <div style={{display:"grid",gridTemplateColumns:"repeat(3,1fr)",gap:16,marginBottom:24}}>
        {stats.map(s=>(
          <div key={s.label} style={{...S.card,cursor:"pointer",borderLeft:`4px solid ${s.color}`,transition:"transform 0.15s"}} onClick={()=>setPage(s.page)}>
            <div style={{display:"flex",justifyContent:"space-between",alignItems:"flex-start"}}>
              <div>
                <div style={{fontSize:11.5,color:C.textL,fontWeight:700,letterSpacing:"0.5px",textTransform:"uppercase",marginBottom:10}}>{s.label}</div>
                <div style={{fontSize:28,fontWeight:900,color:C.text}}>{s.val}</div>
                <div style={{fontSize:12,color:s.color,fontWeight:600,marginTop:6}}>{s.sub}</div>
              </div>
              <div style={{width:46,height:46,borderRadius:13,background:`${s.color}18`,display:"flex",alignItems:"center",justifyContent:"center",fontSize:22}}>{s.icon}</div>
            </div>
          </div>
        ))}
      </div>

      <div style={{display:"grid",gridTemplateColumns:"3fr 2fr",gap:20,marginBottom:20}}>
        <div style={S.card}>
          <div style={{display:"flex",justifyContent:"space-between",alignItems:"center",marginBottom:16}}>
            <div style={{fontSize:15,fontWeight:800}}>Recent Purchase Orders</div>
            <button style={S.btn("ghost",true)} onClick={()=>setPage("orders")}>View all →</button>
          </div>
          {data.orders.length===0?<div style={{textAlign:"center",padding:28,color:C.textL}}>No purchase orders yet.</div>:(
            <table style={S.table}>
              <thead><tr>{["PO #","Vendor","Amount","Status"].map(h=><th key={h} style={S.th}>{h}</th>)}</tr></thead>
              <tbody>{data.orders.map(o=>{const v=data.vendors.find(x=>x.id===o.vendorId);return(
                <tr key={o.id}><td style={{...S.td,fontWeight:800,color:C.tealD,fontSize:13}}>{o.id}</td><td style={S.td}>{v?.name}</td><td style={{...S.td,fontWeight:700}}>{fmt(o.total)}</td><td style={S.td}><span style={S.badge("issued")}>{o.status}</span></td></tr>
              );})}</tbody>
            </table>
          )}
        </div>

        <div style={S.card}>
          <div style={{fontSize:15,fontWeight:800,marginBottom:16}}>⏳ Pending Approvals</div>
          {data.approvals.filter(a=>a.status==="pending").length===0
            ?<div style={{textAlign:"center",padding:28,color:C.green,fontWeight:600}}>✅ All approvals cleared!</div>
            :data.approvals.filter(a=>a.status==="pending").map(a=>{
              const rfq=data.rfqs.find(r=>r.id===a.rfqId);
              return(
                <div key={a.id} style={{padding:"12px 0",borderBottom:`1px solid ${C.border}`,display:"flex",justifyContent:"space-between",alignItems:"center"}}>
                  <div><div style={{fontWeight:600,fontSize:13.5}}>{rfq?.title}</div><div style={{color:C.textL,fontSize:12,marginTop:3}}>by {myName(a.requestedBy)}</div></div>
                  {perms.canApprove?<button style={S.btn("primary",true)} onClick={()=>setPage("approvals")}>Review</button>:<span style={{fontSize:12,color:C.textL}}>Pending</span>}
                </div>
              );
            })
          }
        </div>
      </div>

      <div style={S.card}>
        <div style={{display:"flex",justifyContent:"space-between",alignItems:"center",marginBottom:16}}>
          <div style={{fontSize:15,fontWeight:800}}>Activity Feed</div>
          <button style={S.btn("ghost",true)} onClick={()=>setPage("logs")}>Full log →</button>
        </div>
        {data.logs.slice(0,6).map((l,i)=>{
          const icons={invoice:"🧾",po:"📦",approval:"✅",rfq:"📋",vendor:"🏢"};
